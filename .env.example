# Default Compose ignores credentials and always uses mock GitHub.
DEMO_PORT=8021
GITHUB_MODE=mock
REPO_ALLOWLIST=student-lab/course-project
DATA_DIR=data
# Separate local MCP service only. Never send a PAT in chat or expose it to Web.
# GITHUB_TOKEN=
# MCP_URL=http://127.0.0.1:8022/mcp
# Model credentials belong only to Web; provider is opt-in per task.
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=
MODEL_API_KEY=
